{
  "phase": "Phase 2 — 2nd real dataset: erythroid differentiation (Gastrulation, Pijuan-Sala et al. 2019)",
  "data": {
    "source": "scvelo.datasets.gastrulation_erythroid()",
    "file": "gastrulation_erythroid.h5ad",
    "reference": "Pijuan-Sala et al., Nature 2019; doi:10.1038/s41586-019-0933-9",
    "biology": "Murine erythroid differentiation during gastrulation (E6.5-E8.5)",
    "sha256": "PENDING — computed at first run",
    "min_shared_counts": 20,
    "n_top_genes": 2000,
    "n_pcs": 30,
    "n_neighbors": 30,
    "velocity_mode": "deterministic",
    "cluster_key": "celltype",
    "prepared_name": "prepared_erythroid.npz"
  },
  "state": {
    "space": "gene",
    "d": 8,
    "genes": null,
    "selection_rule": "d genes from velocity_genes with highest Ms variance (same unbiased criterion as pancreas and DG)",
    "biological_priority": ["Gata1", "Klf1", "Hba-a1", "Hba-a2", "Gypa", "Tfrc", "Epor", "Spi1"],
    "scaling": "z = Ms / quantile99(Ms) ; v = velocity / same factor"
  },
  "split": {
    "n_blocks": 60,
    "fractions": [0.6, 0.2, 0.2],
    "seed": 0,
    "note": "Block-wise kNN splitting to prevent spatial leakage"
  },
  "node": {
    "hidden": 64,
    "lr": 0.003,
    "epochs": 600,
    "patience": 80,
    "lam_reg": 0.001,
    "reg_type": "magnitude",
    "train_subsample": 0.8,
    "solver": "dopri5",
    "rtol": 1e-6,
    "atol": 1e-8
  },
  "distillation": {
    "M": 4000,
    "jitter_frac": 0.5,
    "reject_quantile": 0.95,
    "knn": 5,
    "val_fraction": 0.2
  },
  "library": {
    "K_grid": [0.05, 0.1, 0.2, 0.3, 0.5, 0.7, 1.0, 1.5],
    "n_grid": [1.0, 1.5, 2.0, 3.0, 4.0],
    "K_bounds": [0.02, 5.0],
    "n_bounds": [1.0, 6.0],
    "k_max": 3,
    "n_starts": 6,
    "selection_tolerance": 0.05
  },
  "stability": {
    "seeds": [0, 1, 2, 3, 4],
    "lam_sweep": [0.0, 0.001, 0.01, 0.1, 1.0]
  },
  "dynamics": {
    "n_equilibria_starts": 120,
    "progenitor_cluster": "Erythroid1",
    "T_multiplier": 5.0,
    "box_margin": 0.1
  },
  "preregistered_thresholds": {
    "R1_node_test_cosine_min": 0.50,
    "R1_margin_over_shuffled_control": 0.30,
    "R2_symbolic_vs_node_test_cosine_min": 0.90,
    "R7_symbolic_vs_measured_cosine_ratio_min": 0.80,
    "note": "Pre-declared 2026-11-22 before any run. Same thresholds as pancreas and DG for comparability."
  }
}
